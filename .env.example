# ---------------------------------------------------------------------------
# 7orlon — Atelier gallery
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# ---------------------------------------------------------------------------

# The studio desk (/admin). Both are required before anyone can sign in; until
# they are set the login page says so and refuses every attempt.
#
# ADMIN_PASSWORD is what you type. ADMIN_SESSION_SECRET signs the session
# cookie — make it long and random, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing either one signs every browser out.
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# The database is a JSON file in the repository: data/db.json. Set DATA_DIR
# only to keep it somewhere else (a mounted volume, say).
# DATA_DIR="./data"

# Currency conversion (optional).
#
# Prices are stored in USD cents. Leave RATES_PROVIDER unset (or "static") and
# the app uses the fixed table in src/server/providers/rates.ts — no network,
# deterministic, fine for development.
#
# Set it to "exchangerate-host" to fetch live rates instead; the provider then
# needs RATES_API_KEY, and any upstream failure surfaces as a 422 from
# /api/rates rather than a 500.
# RATES_PROVIDER="static"
# RATES_API_KEY=""

# Origin used to build absolute URLs when a Server Component fetches its own
# route handlers. Only needed if you deploy behind a proxy that rewrites Host.
# NEXT_PUBLIC_SITE_URL="http://localhost:3000"
